# Environment Configuration Template
# Bionic Auto Parts / USA Used Auto Parts

# ==============================================================================
# Supabase Backend Configuration
# ==============================================================================
# Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable Key (sb_publishable_..., safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-side project URL and Secret Key (SERVER-SIDE ONLY - NEVER use a NEXT_PUBLIC_ prefix)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
# Legacy (still honored for server if SUPABASE_SECRET_KEY is unset): SUPABASE_SERVICE_ROLE_KEY

# Direct PostgreSQL Database Connection String (for Prisma or direct migrations)
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ==============================================================================
# Application & SEO Settings
# ==============================================================================
# Canonical Public Website URL
NEXT_PUBLIC_SITE_URL="https://www.usausedautopart.com"

# Public Automotive Bot API URL
NEXT_PUBLIC_BOT_API_URL="http://localhost:8000"

# ==============================================================================
# Notifications & Email (Optional)
# ==============================================================================
EMAIL_USER="your-notification-email@example.com"
EMAIL_APP_PASSWORD="your-app-specific-password"

# ==============================================================================
# AWS S3 Storage (Optional / Legacy Fallback)
# ==============================================================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""
